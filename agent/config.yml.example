# config.yml — OMP settings for the workflow.
#
# `modelRoles` selectors are `<provider-id>/<model-id>`, matching the keys in
# models.yml. If you kept a single provider, every role points at the same model
# (that is fine and is the default). Split them later for cost control: put the
# cheap/fast model on `smol`/`task`/`explorer` and the strongest one on `slow`/`plan`.
#
# The installer rewrites __DEFAULT_MODEL__ to `<provider-id>/<model-id>` for you.

providers:
  streamFirstEventTimeoutSeconds: 120
  streamIdleTimeoutSeconds: 180
  webSearchOrder:
    - brave
    - google
    - tavily

modelRoles:
  default:   __DEFAULT_MODEL__
  smol:      __DEFAULT_MODEL__
  slow:      __DEFAULT_MODEL__
  plan:      __DEFAULT_MODEL__
  designer:  __DEFAULT_MODEL__
  task:      __DEFAULT_MODEL__
  advisor:   __DEFAULT_MODEL__
  tiny:      __DEFAULT_MODEL__
  explorer:  __DEFAULT_MODEL__
  fixer:     __DEFAULT_MODEL__
# Oracle role: recommended to set to a different, strongest available model for blind acceptance.
# Priority order and fallback discovery can be customized via agent/oracle-priority.example.json.
  oracle:    __DEFAULT_MODEL__
  reviewer:  __DEFAULT_MODEL__

task:
  isolation:
    mode: auto
    apply: true
    merge: patch
  enableLsp: true
  maxRuntimeMs: 1800000
  maxConcurrency: 8
  showResolvedModelBadge: true
  agentModelOverrides:
    oracle: __DEFAULT_MODEL__
    fixer: __DEFAULT_MODEL__
    explorer: __DEFAULT_MODEL__
  # Workflow tool-call budgets per tier are configured in .workflow/budgets.json
  # (defaults: T0: 10, T1: 25, T2: 45, T3: 45).
  # Subagent lanes emit HANDOFF at ~40-45 calls to leave headroom for reconciliation.
  # softRequestBudget acts as an internal fallback ceiling for agent tasks.
  softRequestBudget: 100

commands:
  enableOpencodeUser: false
  enableOpencodeProject: false
checkpoint:
  enabled: true
display:
  showTurnTime: true
  showTokenUsage: true
terminal:
  showProgress: true
secrets:
  enabled: true
symbolPreset: unicode
composer:
  shape: band
theme:
  dark: titanium
  light: light
setupVersion: 2
memory:
  backend: "off"
tools:
  format: native
