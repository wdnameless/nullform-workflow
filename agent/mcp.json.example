{
  "$schema": "https://json.schemastore.org/mcp-settings.json",
  "$comment": "OPTIONAL MCP fleet. None of these are required for the workflow: agent definitions, rules, skills, and tools all work without them. Keep a server only if you actually use it, and delete the rest — every stdio server is a process OMP must start on session boot. Blank values are removed by the installer; fill them via secrets.env.",

  "mcpServers": {
    "dap-debugger": {
      "$comment": "Interactive debugging (breakpoints, stepping). Pin the version: `@latest` forces a registry round-trip on every cold start and intermittently fails to connect.",
      "command": "cmd.exe",
      "args": ["/c", "npx", "-y", "dap-mcp-server@0.1.17"],
      "env": {}
    },
    "context7": {
      "$comment": "Library documentation lookup. Works keyless at a lower rate limit; set the key for higher limits.",
      "command": "cmd.exe",
      "args": ["/c", "npx", "-y", "@upstash/context7-mcp@4.1.1"],
      "env": {
        "CONTEXT7_API_KEY": "__CONTEXT7_API_KEY__"
      }
    },

    "codebase-index": {
      "$comment": "Semantic code index. Requires the opencode-codebase-index-mcp binary on PATH; remove this entry if you do not have it.",
      "command": "cmd.exe",
      "args": ["/c", "opencode-codebase-index-mcp"],
      "env": {}
    },
    "codegraph": {
      "$comment": "Symbol/call-graph index. Point the path at your own install; remove if unused.",
      "command": "cmd.exe",
      "args": ["/c", "codegraph", "serve", "--mcp"],
      "env": {}
    },
    "playwright": {
      "$comment": "Browser automation for UI verification. Remove if you never do front-end work.",
      "command": "cmd.exe",
      "args": ["/c", "npx", "-y", "@executeautomation/playwright-mcp-server@1.0.12"],
      "env": {}
    },
    "chrome-devtools": {
      "$comment": "Chrome DevTools MCP server for browser inspection, console, network, performance, and automation.",
      "command": "cmd.exe",
      "args": ["/c", "npx", "-y", "chrome-devtools-mcp@1.10.1"],
      "env": {}
    },
    "github": {
      "$comment": "GitHub Official MCP Server (optional). Set GITHUB_PERSONAL_ACCESS_TOKEN to enable issues, PRs, and CI checks.",
      "command": "cmd.exe",
      "args": ["/c", "npx", "-y", "@modelcontextprotocol/server-github@2025.4.8"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "__GITHUB_PAT__"
      }
    },
    "postgres": {
      "$comment": "PostgreSQL MCP Server (optional, read-only DB inspection). Set POSTGRES_URL to your database connection URL.",
      "command": "cmd.exe",
      "args": ["/c", "npx", "-y", "@modelcontextprotocol/server-postgres@0.6.2", "__POSTGRES_URL__"],
      "env": {}
    },
    "docker": {
      "$comment": "Docker MCP Server (optional, container & compose management). Community standard server: github.com/Swartdraak/Docker-MCP",
      "command": "cmd.exe",
      "args": ["/c", "npx", "-y", "@swartdraak/docker-mcp-server@2.0.0"],
      "env": {}
    },

    "memory": {
      "$comment": "Cross-session memory (optional, external service). Point at YOUR deployment, or delete this entry — the workflow degrades to no persistent memory and still works.",
      "type": "http",
      "url": "__MEMORY_MCP_URL__",
      "headers": {
        "Authorization": "Bearer __MEMORY_TOKEN__"
      }
    },
    "crawl4ai": {
      "$comment": "Bulk web scraping (optional, external service). `read <url>` covers single pages; delete this if you only need that.",
      "type": "sse",
      "url": "__CRAWL_MCP_URL__",
      "headers": {
        "Authorization": "Bearer __CRAWL_TOKEN__"
      }
    }
  }
}
