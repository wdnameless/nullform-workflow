# nullform gateway — custom provider for OMP (docs/providers.md).
# This gateway is a dual-surface proxy (exposes BOTH /v1/messages and
# /v1/chat/completions) and returns no `supported_endpoint_types` from
# GET /v1/models, so discovery falls back to the provider-level wire.
#
# Why `modelOverrides` is required: discovery labels the -low/-medium/-high
# variants with the same base name, which makes them indistinguishable in
# /model, and it falls back to conservative context/image metadata for ids it
# cannot match in the catalog.
providers:
  nullform-gateway:
    baseUrl: https://ai-gateway.nullform.cv/v1
    apiKey: __NULLFORM_GATEWAY_KEY__
    api: openai-completions
    authHeader: true
    disableStrictTools: true
    compat:
      supportsReasoningEffort: false
      maxTokensField: max_tokens
      supportsStore: false
      supportsUsageInStreaming: true
    discovery:
      type: proxy
    modelOverrides:
      claude:
        name: Claude (legacy)
      claude-opus-4-6-thinking:
        name: Claude Opus 4.6 (Thinking)
      claude-sonnet-4-6:
        name: Claude Sonnet 4.6 (Thinking)
      gemini-2.5-flash:
        name: Gemini 2.5 Flash
      gemini-2.5-flash-lite:
        name: Gemini 2.5 Flash Lite
      gemini-2.5-flash-thinking:
        name: Gemini 2.5 Flash (Thinking)
      gemini-2.5-pro:
        name: Gemini 2.5 Pro
      gemini-3-flash:
        name: Gemini 3 Flash
      gemini-3-flash-agent:
        name: Gemini 3 Flash (Agent)
        reasoning: True
        contextWindow: 1048576
        input: [text, image]
        thinking:
          mode: effort
          efforts: [minimal, low, medium, high]
          defaultLevel: medium
      gemini-3-pro-high:
        name: Gemini 3 Pro (High)
      gemini-3.1-flash-image:
        name: Gemini 3.1 Flash (Image)
      gemini-3.1-flash-lite:
        name: Gemini 3.1 Flash Lite
      gemini-3.1-pro-high:
        name: Gemini 3.1 Pro (High)
      gemini-3.1-pro-low:
        name: Gemini 3.1 Pro (Low)
      gemini-3.5-flash-extra-low:
        name: Gemini 3.5 Flash (Extra Low)
        reasoning: True
        contextWindow: 1048576
        input: [text, image]
        thinking:
          mode: effort
          efforts: [minimal, low, medium, high]
          defaultLevel: medium
      gemini-3.5-flash-lite:
        name: Gemini 3.5 Flash Lite
      gemini-3.5-flash-low:
        name: Gemini 3.5 Flash (Low)
      gemini-3.6-flash-high:
        name: Gemini 3.6 Flash (High)
      gemini-3.6-flash-low:
        name: Gemini 3.6 Flash (Low)
      gemini-3.6-flash-medium:
        name: Gemini 3.6 Flash (Medium)
      gemini-3.6-flash-tiered:
        name: Gemini 3.6 Flash (Tiered)
        reasoning: True
        contextWindow: 1048576
        input: [text, image]
        thinking:
          mode: effort
          efforts: [minimal, low, medium, high]
          defaultLevel: medium
      gemini-3.7-flash-high:
        name: Gemini 3.7 Flash (High)
      gemini-3.7-flash-low:
        name: Gemini 3.7 Flash (Low)
      gemini-3.7-flash-medium:
        name: Gemini 3.7 Flash (Medium)
      gemini-3.7-flash-tiered:
        name: Gemini 3.7 Flash (Tiered)
        reasoning: True
        contextWindow: 1048576
        input: [text, image]
        thinking:
          mode: effort
          efforts: [minimal, low, medium, high]
          defaultLevel: medium
      gemini-3.8-flash-high:
        name: Gemini 3.8 Flash (High)
      gemini-3.8-flash-low:
        name: Gemini 3.8 Flash (Low)
      gemini-3.8-flash-medium:
        name: Gemini 3.8 Flash (Medium)
      gemini-3.8-flash-tiered:
        name: Gemini 3.8 Flash (Tiered)
        reasoning: True
        contextWindow: 1048576
        input: [text, image]
        thinking:
          mode: effort
          efforts: [minimal, low, medium, high]
          defaultLevel: medium
      gemini-pro-agent:
        name: Gemini 3.1 Pro (Agent)
        reasoning: True
        contextWindow: 1048576
        input: [text, image]
        thinking:
          mode: effort
          efforts: [minimal, low, medium, high]
          defaultLevel: medium
      gpt-oss-120b-medium:
        name: GPT-OSS 120B (Medium)
