# models.yml — provider registry for OMP.
#
# SHAPE MATTERS: it must be map-form (`providers.<id>.models`). A list-form file
# registers the provider under the first model-id segment instead of its declared
# name, which silently breaks every `modelRoles` selector.
#
# This is an EXAMPLE with one OpenAI-compatible provider. Edit the baseUrl,
# apiKey, and model ids to match whatever you actually use, or let the installer
# prompt you. Any OpenAI-compatible endpoint works; OMP also supports providers
# it can discover (see OMP's own provider docs) — those need no entry here at all.
#
# Model ids are opaque strings: whatever your provider calls them.

providers:
  # Rename this provider to anything you like, then update agent/config.yml's
  # `modelRoles` to match — the selector form is `<provider-id>/<model-id>`.
  my-provider:
    baseUrl: __PROVIDER_BASE_URL__
    apiKey: __PROVIDER_API_KEY__
    api: openai-completions
    authHeader: true
    disableStrictTools: true
    compat:
      supportsReasoningEffort: false
      maxTokensField: max_tokens
      supportsStore: false
      supportsUsageInStreaming: true
    discovery:
      type: proxy
    models:
      # The one model the workflow defaults to. Point every role here first;
      # split roles across models later, once you know what your provider offers.
      # Use OMP's `/model` command (or `omp models`) to list real ids.
      - id: __DEFAULT_MODEL_ID__
        name: Default model
        contextWindow: 200000
        maxTokens: 32000
        # Optional: mark a reasoning-capable model so OMP exposes effort levels.
        # reasoning: true
        # thinking:
        #   mode: effort
        #   efforts: [minimal, low, medium, high]
        #   defaultLevel: medium
