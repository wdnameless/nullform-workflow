# Fill these in (or let install.ps1 prompt you). Copy to `secrets.env`; that file
# is git-ignored. Every value is OPTIONAL — put only what you actually use, and
# delete the MCP entries you don't run.

# --- Required if you use a custom OpenAI-compatible provider ---
# Base URL of your provider, ending in /v1 for OpenAI-compatible wire.
PROVIDER_BASE_URL=
# Its API key.
PROVIDER_API_KEY=
# The model id the workflow defaults to (whatever your provider calls it).
DEFAULT_MODEL_ID=

# --- Optional: JEV skill assistance and leaf model routing ---
OPENROUTER_API_KEY=

# --- Optional: external MCP services (delete the matching entry in mcp.json if unused) ---
# Cross-session memory service.
MEMORY_MCP_URL=
MEMORY_TOKEN=
# Bulk scraping service.
CRAWL_MCP_URL=
CRAWL_TOKEN=
# context7 raises its rate limit when keyed; works keyless otherwise.
CONTEXT7_API_KEY=
