[
  {
    "_comment": "MIT idea credit: agency-agents tools.json (harness capability matrix)"
  },
  {
    "id": "claude",
    "label": "Claude Code",
    "description": "~/.claude/CLAUDE.md",
    "detect": {
      "env": "CLAUDE_CONFIG_DIR",
      "file": ".claude",
      "cmd": "claude"
    },
    "install": {
      "userHome": ".claude",
      "projectPaths": [
        "CLAUDE.md"
      ]
    },
    "scopes": [
      "user",
      "project"
    ],
    "runtime": "verified"
  },
  {
    "id": "codex",
    "label": "OpenAI Codex",
    "description": "~/.codex/AGENTS.md",
    "detect": {
      "env": "CODEX_HOME",
      "file": ".codex",
      "cmd": "codex"
    },
    "install": {
      "userHome": ".codex",
      "projectPaths": [
        "AGENTS.md"
      ]
    },
    "scopes": [
      "user",
      "project"
    ],
    "notes": [
      "native catalog path (FCC codex_model_catalog.py)",
      "source: free-claude-code harnesses/codex_model_catalog.py"
    ],
    "runtime": "verified"
  },
  {
    "id": "opencode",
    "label": "OpenCode",
    "description": "Native configuration and adaptive AGENTS.md",
    "detect": {
      "env": "OPENCODE_CONFIG_DIR",
      "file": ".config/opencode",
      "cmd": "opencode"
    },
    "install": {
      "userHome": ".config/opencode",
      "projectPaths": [
        "AGENTS.md",
        "opencode.json",
        "opencode.jsonc"
      ]
    },
    "scopes": [
      "user",
      "project"
    ],
    "runtime": "verified"
  },
  {
    "id": "cursor",
