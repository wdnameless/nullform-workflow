    "detect": {
      "env": null,
      "file": ".cursor",
      "cmd": "cursor"
    },
    "install": {
      "userHome": ".cursor",
      "projectPaths": [
        ".cursor/rules/00-workflow.mdc"
      ]
    },
    "scopes": [
      "project"
    ],
    "runtime": "verified"
  },
  {
    "id": "omp",
    "label": "Oh My Pi (OMP)",
    "description": "~/.omp/agent & ~/.agents/skills",
