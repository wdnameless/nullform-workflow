    ],
    "runtime": "verified"
  },
  {
    "id": "hermes",
    "label": "Hermes Agent",
    "description": "Selected profile: one native auto-load quality skill",
    "detect": {
      "env": "HERMES_HOME",
      "file": ".hermes",
      "cmd": "hermes"
    },
    "versions": {
      "min": "0.20.4",
      "args": [
        "--version"
      ]
    },
    "install": {
      "userHome": ".hermes",
      "projectPaths": [
        "AGENTS.md"
      ]
    },
    "scopes": [
      "user",
      "project"
    ],
    "notes": [
      "HERMES_MANAGED_DIR overlay (FCC hermes.py)",
      "source: free-claude-code cli/launchers/hermes.py"
    ],
    "runtime": "verified",
    "activation": {
      "args": [
        "config",
        "get",
        "model.provider",
        "--json"
      ],
      "expect": "contains"
    }
  },
  {
    "id": "openhuman",
