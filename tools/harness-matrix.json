    "runtime": "verified"
  },
  {
    "id": "openclaw",
    "label": "OpenClaw",
    "description": "Native workspace and adaptive AGENTS.md",
    "detect": {
      "env": "OPENCLAW_STATE_DIR",
      "file": ".openclaw",
      "cmd": "openclaw"
    },
    "install": {
      "userHome": ".openclaw",
      "projectPaths": [
        "AGENTS.md",
        "openclaw.json"
      ]
    },
    "scopes": [
